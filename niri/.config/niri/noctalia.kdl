layout {

    focus-ring {
        active-color   "#e6b4ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e6b4ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#e6b4ff"
        inactive-color "#61317e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e6b4ff80"
    }
}

recent-windows {
    highlight {
        active-color "#e6b4ff"
        urgent-color "#ffb4ab"
    }
}
